# Copy to mail-secrets.yml (same folder) and set the Gmail App Password.
# mail-secrets.yml is gitignored — never commit it.
#
#   copy config\mail-secrets.yml.example config\mail-secrets.yml
#
# Create an App Password at: Google Account → Security → 2-Step Verification → App passwords
# Spaces in the App Password are OK (stripped automatically at runtime).

spring:
  mail:
    host: smtp.gmail.com
    port: 587
    username: rangaram939@gmail.com
    password: "paste-your-app-password-here"

app:
  onboarding:
    mail-from: rangaram939@gmail.com
    smtp-enabled: true
  bootstrap:
    super-admin:
      email: rs@stringstack.ai
      password: "your-super-admin-password"
