# Prefer config/mail-secrets.yml for the App Password (loaded automatically).
# Environment variables remain optional overrides (required on Render):

# HRMS_MAIL_HOST=smtp.gmail.com
# HRMS_MAIL_PORT=587
# HRMS_MAIL_USERNAME=your-gmail@gmail.com
# SPRING_MAIL_PASSWORD=
# HRMS_MAIL_FROM=your-gmail@gmail.com
